# Copy these into your real .env file (never commit real values).

# LiveKit (from your LiveKit Cloud project settings)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
RECEPTIONIST_AGENT_NAME=receptionist

# OpenAI: a standard sk-... key with Realtime API access
OPENAI_API_KEY=sk-your-key

# Gmail SMTP for message alerts. Use an app password:
# Google Account > Security > 2-Step Verification > App passwords
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-16-character-app-password
